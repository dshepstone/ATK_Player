# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
build/
out/
install/
bin/
lib/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
.ninja_deps
.ninja_log
*.ninja

# ---------------------------------------------------------------------------
# Visual Studio / MSVC
# ---------------------------------------------------------------------------
.vs/
*.sln
*.vcxproj
*.vcxproj.*
*.user
*.suo
*.pdb
*.idb
*.ilk
*.obj
*.exp
*.tlog

# ---------------------------------------------------------------------------
# Local build configuration
#
# CMakeUserPresets.json is where a developer puts their own Qt path. It is
# machine-specific by design and must never be committed; CMakePresets.json
# stays portable by reading QT_ROOT instead. See docs/BUILDING.md.
# ---------------------------------------------------------------------------
CMakeUserPresets.json

# ---------------------------------------------------------------------------
# VS Code
#
# tasks.json, launch.json and extensions.json are committed on purpose: they
# reference preset names and ${workspaceFolder}, never an absolute path.
# settings.json is not, because that is where a local Qt path ends up.
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.cache/

# ---------------------------------------------------------------------------
# Qt
# ---------------------------------------------------------------------------
*_autogen/
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.moc
.qmake.stash
Makefile

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
vcpkg_installed/
vcpkg-manifest-install.log
third_party/prebuilt/

# ---------------------------------------------------------------------------
# Binaries that must never be committed
# ---------------------------------------------------------------------------
*.exe
*.dll
*.so
*.so.*
*.dylib
*.a
*.lib
*.app/

# ---------------------------------------------------------------------------
# Packaging output
# ---------------------------------------------------------------------------
*.msi
*.msix
*.dmg
*.AppImage
*.deb
*.rpm
packaging/**/staging/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Python (integrations/)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
aqtinstall.log
