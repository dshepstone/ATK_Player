{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ATK_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "qt",
      "hidden": true,
      "description": "Locates Qt and vcpkg without putting machine-specific paths in this tracked file. Set QT_ROOT to your Qt prefix (e.g. C:/Qt/6.9.3/msvc2022_64) and VCPKG_ROOT to your vcpkg checkout (e.g. C:/dev/vcpkg). A CMakeUserPresets.json can override either.",
      "environment": {
        "QT_ROOT": "$penv{QT_ROOT}",
        "VCPKG_ROOT": "$penv{VCPKG_ROOT}"
      },
      "cacheVariables": {
        "ATK_QT_ROOT": "$env{QT_ROOT}",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "$penv{ATK_VCPKG_INSTALLED_DIR}"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": [
        "qt",
        "base"
      ],
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ]
        }
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x64 Debug (Ninja + MSVC)",
      "description": "Primary development build. Needs an MSVC environment: the VS Code CMake Tools kit, or a Developer Command Prompt for VS 2022.",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release (Ninja + MSVC)",
      "description": "Optimised build with debug information retained.",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-vs2022",
      "displayName": "Windows x64 (Visual Studio 2022 generator)",
      "description": "Multi-config fallback that locates MSVC itself, for use outside a Developer Command Prompt.",
      "inherits": [
        "qt",
        "base"
      ],
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "inherits": [
        "qt",
        "base"
      ],
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets"
      }
    },
    {
      "name": "macos-arm64-debug",
      "displayName": "macOS Apple silicon (arm64) Debug (Ninja + Apple Clang)",
      "description": "Development build. FFmpeg comes from vcpkg through the arm64-osx-atk overlay triplet (dynamic, macOS 12+).",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "VCPKG_TARGET_TRIPLET": "arm64-osx-atk"
      }
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS Apple silicon (arm64) Release (Ninja + Apple Clang)",
      "description": "Optimised build with debug information retained. FFmpeg comes from vcpkg through the arm64-osx-atk overlay triplet (dynamic, macOS 12+).",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "VCPKG_TARGET_TRIPLET": "arm64-osx-atk"
      }
    },
    {
      "name": "macos-x64-debug",
      "displayName": "macOS Intel (x86_64) Debug (Ninja + Apple Clang)",
      "description": "Development build. FFmpeg comes from vcpkg through the x64-osx-atk overlay triplet (dynamic, macOS 12+).",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "VCPKG_TARGET_TRIPLET": "x64-osx-atk"
      }
    },
    {
      "name": "macos-x64-release",
      "displayName": "macOS Intel (x86_64) Release (Ninja + Apple Clang)",
      "description": "Optimised build with debug information retained. FFmpeg comes from vcpkg through the x64-osx-atk overlay triplet (dynamic, macOS 12+).",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "VCPKG_TARGET_TRIPLET": "x64-osx-atk"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "windows-vs2022-debug",
      "configurePreset": "windows-vs2022",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2022-release",
      "configurePreset": "windows-vs2022",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug"
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release"
    },
    {
      "name": "macos-x64-debug",
      "configurePreset": "macos-x64-debug"
    },
    {
      "name": "macos-x64-release",
      "configurePreset": "macos-x64-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-vs2022-debug",
      "configurePreset": "windows-vs2022",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-x64-debug",
      "configurePreset": "macos-x64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-x64-release",
      "configurePreset": "macos-x64-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
